# Configuración del servidor
SERVER_ADDR=127.0.0.1:8080
SERVER_ENV=development  # development, staging, production

# Configuración PostgreSQL
DATABASE_URL=postgres://usuario:contraseña@localhost:5432/rapidito
DATABASE_MAX_CONNECTIONS=10
DATABASE_TIMEOUT_SECONDS=5

# Configuración Redis
REDIS_URL=redis://127.0.0.1:6379
REDIS_PASSWORD=

# Autenticación y seguridad
JWT_SECRET=tu_clave_secreta_muy_segura_minimo_32_caracteres
JWT_EXPIRATION=24h
COOKIE_SECRET=otra_clave_secreta_diferente

# Configuración de Logging
LOG_LEVEL=info  # debug, info, warn, error

# Configuración de CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://rapidito-app.com

# Timeouts
WEBSOCKET_HEARTBEAT_INTERVAL=5
WEBSOCKET_CLIENT_TIMEOUT=10

# Notificaciones
ENABLE_EMAIL_NOTIFICATIONS=false
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=user@example.com
SMTP_PASSWORD=tu_password_smtp
EMAIL_FROM=noreply@rapidito-app.com

# Almacenamiento de archivos (para imágenes)
STORAGE_TYPE=local  # local, s3
STORAGE_LOCAL_PATH=./uploads
# Solo si STORAGE_TYPE=s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_BUCKET_NAME=rapidito-uploads

# Configuración del Pool Manager
POOL_REBALANCE_INTERVAL=5  # segundos
TARGET_CLIENTS_PER_POOL=33