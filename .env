# Configuración del servidor
SERVER_ADDR=127.0.0.1:8080
SERVER_ENV=development

# Configuración PostgreSQL (actualiza esto con tus credenciales reales)
DATABASE_URL=postgres://postgres:175221@localhost:5432/rapidito
DATABASE_MAX_CONNECTIONS=10
DATABASE_TIMEOUT_SECONDS=5

# Configuración Redis
REDIS_URL=redis://127.0.0.1:6379

# Autenticación y seguridad (¡cambia estas claves por valores seguros!)
JWT_SECRET=TuClaveSecretaRealmenteLargaYSeguraParaJWT12345
JWT_EXPIRATION=24h
COOKIE_SECRET=OtraClaveSecretaDiferenteParaCookies98765

# Configuración de Logging
LOG_LEVEL=debug

# Resto de la configuración según sea necesario...